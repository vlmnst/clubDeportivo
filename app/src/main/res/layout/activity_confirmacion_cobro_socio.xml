<?xml version="1.0" encoding="utf-8"?>
<!-- El DrawerLayout es el nuevo elemtento para meni hamburgesa -->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MenuPrincipal">

    <!-- CONTINUACIPN DEL COFDIGO!!! -->
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:context=".ConfirmacionCobroSocioActivity">

        <!-- Llamado al menu hamburguesa -->
        <include
            android:id="@+id/toolbar_container"
            layout="@layout/toolbar_main">

        </include>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E6F7FF"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="20dp">

                <!-- TEXTO-->
                <TextView
                    android:id="@+id/tvCobroExitoso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="100sp"
                    android:layout_marginHorizontal="30dp"
                    android:gravity="center"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:text="El [Socio / No socio] [Nombre completo] realizó el pago de su [Cuota / actividad] correctamente"/>


                <TextView
                    android:id="@+id/tvNuevaFechaVencimiento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="35dp"
                    android:layout_marginVertical="50sp"
                    android:gravity="center"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:text="Registrado exitosamente con fecha de vencimiento"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_volverGestion"
                        android:layout_width="280dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Volver a gestion de clientes"
                        android:backgroundTint="@null"
                        android:background="@drawable/btn_primario"
                        android:textColor="#FFFFFF"
                        android:paddingRight="50dp"
                        android:paddingLeft="50dp"
                        android:layout_marginBottom="50dp"
                        android:textSize="18sp"
                        tools:ignore="InvalidId" />

            </LinearLayout>


            <!-- Usuario y Contraseña -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="400dp"
                        android:layout_height="400dp"
                        android:alpha="0.3"
                        android:scaleType="fitEnd"
                        android:src="@drawable/logo"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/toolbar_container" />

                </FrameLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- El NavigationView (el menú deslizable) -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:menu="@menu/nav_menu"
        app:itemIconTint="@color/club_primary_blue"
        />

</androidx.drawerlayout.widget.DrawerLayout>