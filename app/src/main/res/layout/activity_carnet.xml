<?xml version="1.0" encoding="utf-8"?>

<!-- El DrawerLayout es el nuevo elemtento para meni hamburgesa -->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MenuPrincipal">

    <!-- CONTINUACIPN DEL COFDIGO!!! -->
    <LinearLayout
        android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MenuPrincipal">

    <!-- LLAMA AL MENU HAMBURGESA -->
    <include
        android:id="@+id/toolbar_container"
        layout="@layout/toolbar_main">

    </include>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6F7FF"
        android:orientation="vertical">
        <!-- TEXTo-->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="30dp"
            android:gravity="center"
            android:text="Carnet de socio"
            android:textColor="#002244"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/liner_Carnet"
            android:layout_width="match_parent"
            android:layout_height="410dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/borde_redondeado"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:orientation="horizontal">


                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imagen_perfil_socio"
                    android:layout_width="140dp"
                    android:layout_height="150dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="30dp"

                    android:scaleType="centerCrop"
                    android:src="@drawable/persona"

                    app:shapeAppearanceOverlay="@style/esquinasRedondeadas" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_gravity="center"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtNombre"
                        android:layout_width="177dp"
                        android:layout_height="86dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="35dp"
                        android:layout_marginRight="16dp"
                        android:text="Nombre y apellido"
                        android:textColor="#002244"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="350dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:orientation="vertical">


                <TextView
                    android:id="@+id/tv_socio"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:text="Socio N°" />

                <TextView
                    android:id="@+id/tv_dni"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginBottom="10dp"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:text="DNI" />

                <TextView
                    android:id="@+id/tv_apto_fisico"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginBottom="10dp"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:text="Apto fisico" />

                <TextView
                    android:id="@+id/tv_fecha_inscripcion"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:text="Fecha inscripción" />

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">


                <LinearLayout
                    android:layout_width="150dp"
                    android:layout_height="70dp"
                    android:layout_gravity="center"
                    android:background="@drawable/btn_primario"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="horizontal"
                    android:padding="15dp">
                    <ImageButton
                        android:id="@+id/imgCompartir"
                        android:layout_width="39dp"
                        android:layout_height="41dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="20dp"
                        android:background="@drawable/btn_primario"
                        android:contentDescription="compartir"
                        android:src="@drawable/compartir" />

                    <ImageButton
                        android:id="@+id/imgDescargar"
                        android:layout_width="34dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="35dp"
                        android:background="@drawable/btn_primario"
                        android:contentDescription="descargar"
                        android:src="@drawable/descargar" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>



    <!-- El NavigationView (el menú deslizable) -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:menu="@menu/nav_menu"
        app:itemIconTint="@color/club_primary_blue"
        />

</androidx.drawerlayout.widget.DrawerLayout>