<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CobroCuotaSocio">

    <!-- Contenido principal -->
    <LinearLayout
        android:id="@+id/CobroCuotaSocio"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Toolbar -->
        <include
            android:id="@+id/toolbar_container"
            layout="@layout/toolbar_main" />

        <!-- Contenedor de contenido -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#E6F7FF"
            android:paddingTop="20dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <!-- Encabezado -->
            <TextView
                android:id="@+id/textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Cobro Cuota Socio"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp" />

            <!-- Monto a pagar -->
            <TextView
                android:id="@+id/textMontoLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Monto a pagar:"
                android:padding="5dp"
                android:layout_marginBottom="5dp" />

            <TextView
                android:id="@+id/txt_Monto_Pagar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ingreso_datos"
                android:gravity="center"
                android:padding="10dp"
                android:textColor="#000000"
                android:layout_marginBottom="20dp" />


            <EditText
                android:id="@+id/inputDniSocio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ingrese DNI del Socio"
                android:inputType="number"
                android:layout_marginHorizontal="20dp"/>

            <!-- Método de pago -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Selecciona el método de pago"
                android:gravity="center"
                android:layout_marginBottom="10dp"/>

            <RadioGroup
                android:id="@+id/radioGroupPago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <RadioButton
                    android:id="@+id/btnEfectivo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Efectivo"
                    android:textSize="18sp" />

                <RadioButton
                    android:id="@+id/btnTarjeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tarjeta"
                    android:textSize="18sp" />

            </RadioGroup>

            <!-- Imagen + botón -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="20dp">

                <ImageView
                    android:layout_width="400dp"
                    android:layout_height="400dp"
                    android:layout_gravity="center"
                    android:alpha="0.3"
                    android:scaleType="fitEnd"
                    android:src="@drawable/logo" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnRegistrarPago"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center|top"
                    android:layout_marginTop="50dp"
                    android:background="@drawable/btn_primario"
                    android:backgroundTint="@null"
                    android:paddingLeft="50dp"
                    android:paddingRight="50dp"
                    android:text="Registrar Pago"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    tools:ignore="InvalidId" />
            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Navigation drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:menu="@menu/nav_menu"
        app:itemIconTint="@color/club_primary_blue" />

</androidx.drawerlayout.widget.DrawerLayout>
